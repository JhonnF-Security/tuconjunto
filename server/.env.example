# TuConjunto API — configuración por entorno
# Copia este archivo a .env y ajusta lo necesario: cp .env.example .env
# Las variables de entorno reales tienen prioridad sobre este archivo.

# Puerto de escucha (default 8081)
PORT=8081

# Interfaz de escucha (default 0.0.0.0 = todas)
HOST=0.0.0.0

# TLS: si AMBAS rutas existen → servidor HTTPS; si no, HTTP.
# Genera certificados con:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout tls/key.pem -out tls/cert.pem -days 365
#TLS_KEY=./tls/key.pem
#TLS_CERT=./tls/cert.pem

# Cookie Secure: auto (default) = Secure solo en requests HTTPS;
# true = siempre; false = nunca (solo para pruebas locales sin TLS).
COOKIE_SECURE=auto

# Saltos de proxy de confianza para req.secure/req.ip detrás de proxy TLS
# (nginx/traefik/caddy que terminan HTTPS). 0 = directo (default).
TRUST_PROXY=0

# Ruta del archivo SQLite (default data/tuconjunto.db, relativa al servidor)
DB_FILE=data/tuconjunto.db

# ---------------------------------------------------------------------
# Pasarela de pagos PSE (para enlazar la cuenta real del conjunto)
# Hoy la app usa el simulador interno. Al contratar Wompi (recomendada:
# checkout por redirección, PSE nativo COP, sandbox gratuito):
#   PAYMENTS_PROVIDER=wompi  y llena las llaves que entrega su dashboard.
# Documentación completa: deploy/PSE-INTEGRACION.md
# ---------------------------------------------------------------------
PAYMENTS_PROVIDER=none            # none (simulado) | wompi
WOMPI_ENV=sandbox                 # sandbox | production
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
APP_PUBLIC_BASE_URL=              # ej. https://tuconjunto.tudominio.co (redirect + webhook)
PAGOS_TIMEOUT_MINUTOS=30
