{
  "name": "tu-conjunto",
  "version": "0.1.0",
  "description": "Plataforma web para la administración de conjuntos residenciales y copropiedades: pagos, reservas, PQRS, comunicaciones y accesos.",
  "main": "index.html",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --watch"
  },
  "keywords": ["propiedad-horizontal", "conjuntos-residenciales", "copropiedades"],
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "3.4"
  }
}
